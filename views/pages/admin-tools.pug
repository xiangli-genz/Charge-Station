extends ../layouts/main

block content
  .shell
    .editor-topbar
      div
        p.sidebar-title Admin Data Tools
        h1 Quan ly danh sach du lieu
        p Xem danh sach, tim kiem, tao moi, sua va xoa du lieu trong he thong.
      .editor-topbar-actions
        a.btn.ghost(href='/admin-import-tools') Import du lieu
        a.btn.ghost(href='/') Trang chu

    .tools-layout
      aside.card.sidebar-card
        p.sidebar-title Quan ly du lieu
        .sidebar-menu
          button#nav-pricings.sidebar-item.active(type='button', data-panel='pricings')
            span Bang gia
          button#nav-stations.sidebar-item(type='button', data-panel='stations')
            span Tram sac
          button#nav-swap-stations.sidebar-item(type='button', data-panel='swap-stations')
            span Tram doi pin
          button#nav-charging-points.sidebar-item(type='button', data-panel='charging-points')
            span Cong sac
          button#nav-bookings.sidebar-item(type='button', data-panel='bookings')
            span Booking
          a.sidebar-item.sidebar-item-link(href='/admin-import-tools') Import CSV / JSON

      section.card.manager-card
        .manager-toolbar
          .manager-heading
            p.sidebar-title Danh sach
            h2#managerTitle Bang gia
            p#managerSummary.helper Xem va thao tac nhanh tren du lieu da tao.
          .manager-actions
            input#managerSearch(type='text', placeholder='Tim kiem nhanh trong danh sach hien tai')
            .manager-buttons
              button#managerSearchBtn.secondary(type='button') Tim kiem
              button#managerRefreshBtn.secondary(type='button') Lam moi
              button#managerCreateBtn(type='button') Tao moi

        #managerStatus.status Dang tai danh sach...
        .manager-meta
          span#managerCount 0 ban ghi
        #managerList.manager-list

block scripts
  script(src='/js/admin-entities.js')
  script(src='/js/admin-import.js')
