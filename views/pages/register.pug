extends ../layouts/main

block content
  main.auth-shell
    .topbar
      a.brand(href='/') Tram Sac Hub
      .nav-actions
        a.btn.ghost(href='/') Trang chu
        a.btn.ghost(href='/login') Dang nhap admin

    .auth-grid
      section.panel.soft
        p.eyebrow Admin Access
        h1 Tao tai khoan admin
        p.lead Trang nay chi dung de tao tai khoan admin trong MongoDB. Tai khoan superadmin khong dang ky tren giao dien.
        ul.helper
          li Can nhap `ADMIN_REGISTER_SECRET` de tao tai khoan admin.
          li Superadmin dung thong tin dang nhap co dinh trong `.env`.
          li Sau khi dang ky thanh cong, he thong chuyen vao dashboard admin.

      section.panel
        h2 Thong tin admin
        .stack
          div
            label.field-label(for='fullName') Ho ten
            input#fullName.text-input(type='text', placeholder='Admin Tong')
          div
            label.field-label(for='phone') So dien thoai
            input#phone.text-input(type='text', placeholder='0901234567')
          div
            label.field-label(for='email') Email
            input#email.text-input(type='email', placeholder='admin@example.com')
          div
            label.field-label(for='password') Mat khau
            input#password.text-input(type='password', placeholder='123456')
          div
            label.field-label(for='adminRegisterSecret') Admin Register Secret
            input#adminRegisterSecret.text-input(type='password', placeholder='Secret trong .env')
          button#registerSubmitBtn.btn.primary(type='button') Dang ky admin
          #registerStatus.status-box Chua dang ky.
        p.helper(style='margin-top: 18px;') Neu da co tai khoan, quay lai trang dang nhap.

block scripts
  script(src='/js/register.js')
