            button#refreshMapBtn.primary-btn(type='button') Lam moi

        .map-filters
          .filter-field.filter-field-search
            label(for='stationSearch' data-i18n='searchLabel') Tim kiem
            input#stationSearch(type='search', placeholder='Ten tram hoac dia chi')
          .filter-field
            label(for='cityFilter' data-i18n='cityLabel') Thanh pho/Tinh
            select#cityFilter
              option(value='all') Tat ca
          .filter-field
            label(for='districtFilter' data-i18n='districtLabel') Quan/Huyen
            select#districtFilter
              option(value='all') Tat ca
          .filter-field
            label(for='connectorTypeFilter' data-i18n='connectorLabel') Loai cong sac
            select#connectorTypeFilter
              option(value='all') Tat ca
          .filter-field
