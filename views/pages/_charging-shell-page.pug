                      dd#stationDetailCurrentType --
                    div
                      dt So cong sac
                      dd#stationDetailPorts --
                    div
                      dt Gia dich vu
                      dd#stationDetailPricing --
                    div
                      dt Trang thai
                      dd#stationDetailStatusText --
                    div
                      dt Mo 24/7
                      dd#stationDetailOpen247 --
