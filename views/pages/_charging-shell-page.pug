                span(data-status-label='all') Tat ca
              button.status-filter-btn(type='button', data-status='ready')
                span.status-filter-dot.ready
                span(data-status-label='ready') San sang
              button.status-filter-btn(type='button', data-status='full')
                span.status-filter-dot.full
                span(data-status-label='full') Day
              button.status-filter-btn(type='button', data-status='maintenance')
                span.status-filter-dot.maintenance
                span(data-status-label='maintenance') Bao tri
              button.status-filter-btn(type='button', data-status='inactive')
                span.status-filter-dot.inactive
                span(data-status-label='inactive') Chua hoat dong
              button.status-filter-btn(type='button', data-status='closed')
                span.status-filter-dot.closed
                span(data-status-label='closed') Dong cua

        .map-content
