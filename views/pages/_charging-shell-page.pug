extends ../layouts/main

block head
  link(rel='stylesheet', href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css')

block content
  main.app-shell
    header.app-header
      .header-left
        button#sidebarToggle.icon-btn(type='button', aria-label='Mo menu') Menu
        a.app-logo(href='/') S.TOUCH
        button#themeToggle.theme-toggle(type='button', aria-label='Doi giao dien')
          span#themeLabel Light
      .header-actions
        .header-search-wrap
          button#searchToggle.icon-btn(type='button', aria-label='Tim kiem') Search
          input#headerSearch.header-search(type='search', placeholder='Tim tram, dia chi...')
        .header-menu-wrap
          button#notificationToggle.icon-btn(type='button', aria-label='Thong bao') Bell
          .floating-menu.notification-menu#notificationMenu
            strong Thong bao
            p#notificationEmpty Chua co thong bao moi.
        button#languageToggle.language-toggle(type='button') VI
        .profile-wrap
          button#profileToggle.profile-trigger(type='button', aria-label='Mo ho so')
            span#avatarInitials.avatar NK
            span.profile-copy
              strong#profileName Nguoi dung
              small#profileWallet Vi: 0 VND
          .floating-menu.profile-menu#profileMenu
            strong#profileMenuName Nguoi dung
            button#profileAction(type='button') Ho so ca nhan
            button#logoutAction.secondary(type='button') Dang xuat

    .app-body
      aside#appSidebar.app-sidebar
        .sidebar-brand
          span.sidebar-mark ST
          div
            strong Quản trị trạm sạc
            small Web app
        nav.app-nav(aria-label='Dieu huong chinh')
          button.nav-item.active(type='button', data-view='map')
            span.nav-icon Map
            span(data-i18n='map') Bản đồ
          button.nav-item(type='button', data-view='stations')
            span.nav-icon ST
            span(data-i18n='stations') Trạm sạc
          button.nav-item(type='button', data-view='swap')
            span.nav-icon SW
            span(data-i18n='swap') Trạm đổi pin
          button.nav-item(type='button', data-view='notifications')
            span.nav-icon NT
            span(data-i18n='notifications') Thông báo
          button#managementNavToggle.nav-item.nav-item-expand(type='button', aria-expanded='false')
            span.nav-icon QL
            span Quản lý
            span.nav-caret(aria-hidden='true')
          .nav-submenu#managementNavSubmenu(hidden)
            button.nav-subitem(type='button', data-view='accounts')
              span Tài khoản
            .nav-subgroup
              button#stationNavToggle.nav-subitem.nav-subitem-expand(type='button', aria-expanded='false')
                span Trạm sạc
                span.nav-caret(aria-hidden='true')
              .nav-submenu.nav-submenu-nested#stationNavSubmenu(hidden)
                button.nav-subitem.nav-subitem-nested(type='button', data-view='station-map')
                  span Bản đồ
                button.nav-subitem.nav-subitem-nested(type='button', data-view='station-info')
                  span Thông tin
            button.nav-subitem(type='button', data-view='charging-points')
              span Cổng sạc
            button.nav-subitem(type='button', data-view='pricings')
              span Giá dịch vụ
            button.nav-subitem(type='button', data-view='manage-swap')
              span Trạm đổi pin
          button#reportNavToggle.nav-item.nav-item-expand(type='button', aria-expanded='false')
            span.nav-icon BC
            span Báo cáo
            span.nav-caret(aria-hidden='true')
          .nav-submenu#reportNavSubmenu(hidden)
            button.nav-subitem(type='button', data-view='report-summary')
              span Báo cáo tổng hợp
            button.nav-subitem(type='button', data-view='station-distribution')
              span Phân bổ trạm sạc
            button.nav-subitem(type='button', data-view='bookings')
              span Lịch sử đặt lịch
          button#systemNavToggle.nav-item.nav-item-expand(type='button', aria-expanded='false')
            span.nav-icon HT
            span Cấu hình hệ thống
            span.nav-caret(aria-hidden='true')
          .nav-submenu#systemNavSubmenu(hidden)
            button.nav-subitem(type='button', data-view='roles')
              span Vai trò
            button.nav-subitem(type='button', data-view='permissions')
              span Quyền
            button.nav-subitem(type='button', data-view='login-pages')
              span Trang đăng nhập
            button.nav-subitem(type='button', data-view='sim-types')
              span Loại sim
          button#deviceConfigNavToggle.nav-item.nav-item-expand(type='button', aria-expanded='false')
            span.nav-icon TB
            span Cấu hình thiết bị
            span.nav-caret(aria-hidden='true')
          .nav-submenu#deviceConfigNavSubmenu(hidden)
            button.nav-subitem(type='button', data-view='device-types')
              span Loại thiết bị
            button.nav-subitem(type='button', data-view='connector-types')
