extends ../layouts/main

block content
  main.auth-shell
    - var authBackgroundStyle = authPageConfig && authPageConfig.backgroundImage ? 'background-image: linear-gradient(135deg, rgba(15, 118, 110, 0.08), rgba(255, 250, 242, 0.9)), url(' + authPageConfig.backgroundImage + '); background-size: cover; background-position: center;' : ''
    .topbar
      a.brand(href='/')= (authPageConfig && authPageConfig.companyName) || 'Tram Sac Hub'
      .nav-actions
        a.btn.ghost(href='/') Trang chu
        a.btn.ghost(href='/admin/login') Dang nhap admin

    .auth-grid
      section.panel.soft.auth-brand-panel(style=authBackgroundStyle)
        if authPageConfig && authPageConfig.logoImage
          img.auth-brand-logo(src=authPageConfig.logoImage, alt='Logo dang nhap')
        p.eyebrow Admin Access
        h1 Tao tai khoan admin
        p.lead
          | Trang nay chi dung de tao tai khoan admin trong MongoDB. Tai khoan admin he thong duoc cau hinh truc tiep trong file `.env`.
          if authPageConfig && authPageConfig.website
            |  Website: 
            a(href=authPageConfig.website, target='_blank', rel='noreferrer')= authPageConfig.website
        ul.helper
          li Can nhap `ADMIN_REGISTER_SECRET` de tao tai khoan admin.
          li Tai khoan admin he thong dung thong tin dang nhap co dinh trong `.env`.
          li Sau khi dang ky thanh cong, he thong chuyen vao trang chu quan tri.
        if authPageConfig && authPageConfig.guideLink
          .hero-actions
            a.btn.ghost(href=authPageConfig.guideLink, target='_blank', rel='noreferrer') Huong dan su dung

      section.panel
        h2 Thong tin admin
        .stack
          div
            label.field-label(for='fullName') Ho ten
            input#fullName.text-input(type='text', placeholder='Admin Tong')
          div
            label.field-label(for='phone') So dien thoai
            input#phone.text-input(type='text', placeholder='0901234567')
          div
            label.field-label(for='email') Email
            input#email.text-input(type='email', placeholder='admin@example.com')
          div
            label.field-label(for='password') Mat khau
            input#password.text-input(type='password', placeholder='123456')
          div
            label.field-label(for='adminRegisterSecret') Admin Register Secret
            input#adminRegisterSecret.text-input(type='password', placeholder='Secret trong .env')
          button#registerSubmitBtn.btn.primary(type='button') Dang ky admin
          #registerStatus.status-box Chua dang ky.
        p.helper(style='margin-top: 18px;') Neu da co tai khoan, quay lai trang dang nhap.

block scripts
  script(src='/admin/assets/js/register.js')
