extends ../layouts/main

block content
  .shell
    .editor-topbar
      div
        p.sidebar-title Form Quan Tri
        h1#editorPageTitle Nhap tay du lieu
        p#editorPageLead Tao moi hoac sua du lieu trong he thong.
      .editor-topbar-actions
        a.btn.ghost(href='/admin-tools') Quay lai danh sach

    section.card.editor-card
      .manual-header
        div
          h2#manualFormTitle Nhap tay bang gia
          p#manualFormLead Tao moi hoac sua bang gia hien co.
        span#manualModeBadge.mode-badge Tao moi

      .row
        div
          label(for='manualDataset') Loai du lieu
          select#manualDataset
            option(value='pricings') Bang gia
            option(value='charging-points') Cong sac
            option(value='bookings') Booking
        div
          label(for='manualHint') Ghi chu nhanh
          input#manualHint(type='text', value='Moi du lieu se co bo truong rieng, form se doi theo lua chon.', readonly='')

      #manualFieldGrid.manual-grid

      .row(style='margin-top: 20px;')
        button#manualSubmitBtn Tao du lieu
        button#manualResetBtn.secondary(type='button') Huy sua / lam moi

      #manualStatus.status Chua gui form nhap tay.

block scripts
  script(src='/admin/assets/js/admin-entities.js')
  script(src='/admin/assets/js/admin-editor.js')
