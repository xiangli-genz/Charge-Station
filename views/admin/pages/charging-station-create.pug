.modal-backdrop#stationModal(aria-hidden='true')
  section.station-editor-modal(role='dialog', aria-modal='true', aria-labelledby='stationModalTitle')
    button#closeStationModal.modal-close(type='button', aria-label='Dong tram sac') X
    .station-editor-head
      div
        h2#stationModalTitle Tạo mới trạm sạc
        p#stationModalLead Chọn vị trí trên bản đồ hoặc tìm địa điểm để tự điền thông tin trạm sạc.
    #stationModalFeedback.status-box.error(hidden) Thông tin trạm sạc chưa hợp lệ.
    form#stationEditorForm
      input#stationEditorId(type='hidden')
      .station-editor-layout
        .station-editor-main
          .management-form-grid.station-editor-grid
            .management-form-field
              label(for='stationModalImei') IMEI
              input#stationModalImei(type='text', placeholder='8657265579')
            .management-form-field
              label(for='stationModalName') Tên trạm *
              input#stationModalName(type='text', required=true, placeholder='Trạm sạc Hà Nội Center')
            .management-form-field.station-map-field.wide
              label(for='stationLocationSearch') Tìm vị trí trên bản đồ
              .station-location-search
                input#stationLocationSearch(type='search', placeholder='Nhập địa chỉ, tên khu vực hoặc địa danh')
                button#stationLocationSearchBtn.outline-btn(type='button', data-action='search-station-location') Tìm trên bản đồ
              #stationLocationSearchResults.station-location-results(hidden)
              #stationModalMap.station-modal-map
              p.station-map-hint Click trên bản đồ để chọn nhanh vị trí trạm sạc.
            .management-form-field
              label(for='stationModalLat') Vĩ độ *
              input#stationModalLat(type='number', step='0.000001', required=true, placeholder='21.028511')
            .management-form-field
              label(for='stationModalLng') Kinh độ *
              input#stationModalLng(type='number', step='0.000001', required=true, placeholder='105.804817')
            .management-form-field
              label(for='stationModalCity') Thành phố/Tỉnh
              input#stationModalCity(type='text', placeholder='Tự động từ bản đồ')
            .management-form-field
              label(for='stationModalDistrict') Quận/Huyện
              input#stationModalDistrict(type='text', placeholder='Tự động từ bản đồ')
            .station-main-stack
              .station-brief-row
                .management-form-field
                  label(for='stationModalAddress') Địa chỉ *
                  textarea#stationModalAddress(rows='3', required=true, placeholder='Địa chỉ trạm sạc')
                .management-form-field
                  label(for='stationModalNotes') Mô tả nhanh
                  textarea#stationModalNotes(rows='3', placeholder='Ghi chú nhanh về trạm sạc, khu vực, dịch vụ...')
              .management-form-field.station-status-inline
                label(for='stationModalStatusSelect') Trạng thái
                select#stationModalStatusSelect
                  option(value='active') Hoạt động
                  option(value='maintenance') Bảo trì
                  option(value='inactive') Chưa hoạt động
                  option(value='closed') Đóng cửa
            .station-extra-section.station-extra-right
              .station-extra-head
                strong Thông tin bổ sung
                span Cấu hình vận hành và thông tin kỹ thuật của trạm
              .station-extra-grid
                .management-form-field
                  label(for='stationModalChargingType') Loại sạc
                  input#stationModalChargingType(type='text', placeholder='AC, DC, hỗn hợp...')
                .management-form-field.wide
                  label(for='stationModalConnectorTypes') Các loại cổng sạc của trạm
                  textarea#stationModalConnectorTypes(rows='3', placeholder='CCS2, Type 2, CHAdeMO...')
                .management-form-field
                  label(for='stationModalCurrentType') Loại dòng điện
                  input#stationModalCurrentType(type='text', placeholder='1 pha, 3 pha, DC...')
                .management-form-field.station-toggle-field
                  label Kích hoạt
                  label.station-toggle-card
                    input#stationModalIsActivated(type='checkbox')
                    span.station-toggle-state
                      span.station-toggle-off Tắt
                      span.station-toggle-on Bật
                .management-form-field
                  label(for='stationModalActivatedAt') Ngày kích hoạt
                  input#stationModalActivatedAt(type='date')
                .management-form-field
                  label(for='stationModalWarrantyUntil') Ngày bảo hành
                  input#stationModalWarrantyUntil(type='date')
                .management-form-field
                  label(for='stationModalSimType') Loại SIM
                  input#stationModalSimType(type='text', placeholder='4G, eSIM...')
                .management-form-field
                  label(for='stationModalSimNumber') Số SIM
                  input#stationModalSimNumber(type='text', placeholder='Số SIM quản lý')
                .management-form-field
                  label(for='stationModalBillingSimNumber') Số SIM thanh toán
                  input#stationModalBillingSimNumber(type='text', placeholder='SIM thanh toán')
                .management-form-field
                  label(for='stationModalSupportPhone') Số điện thoại hỗ trợ
                  input#stationModalSupportPhone(type='text', placeholder='Hotline hỗ trợ')
                .management-form-field.station-toggle-field
                  label Mở 24/7
                  label.station-toggle-card
                    input#stationModalOpen247(type='checkbox')
                    span.station-toggle-state
                      span.station-toggle-off Tắt
                      span.station-toggle-on Bật
                .management-form-field.wide
                  label(for='stationModalAmenities') Tiện nghi
                  textarea#stationModalAmenities(rows='3', placeholder='Nhập các tiện nghi, ngăn cách bằng dấu phẩy hoặc xuống dòng')
        aside.station-editor-side
          .station-editor-side-card
            strong Vị trí đã chọn
            dl.station-editor-side-grid
              div
                dt IMEI
                dd#stationPreviewImei --
              div
                dt Tên trạm
                dd#stationPreviewName --
              div
                dt Tọa độ
                dd#stationPreviewCoords --
              div
                dt Khu vực
                dd#stationPreviewArea --
              div
                dt Địa chỉ
                dd#stationPreviewAddress --
              div
                dt Trạng thái
                dd#stationPreviewStatus Hoạt động
              div
                dt Loại sạc
                dd#stationPreviewChargingType --
              div
                dt Loại dòng điện
                dd#stationPreviewCurrentType --
              div
                dt Kích hoạt
                dd#stationPreviewActivated --
              div
                dt Mở 24/7
                dd#stationPreviewOpen247 --
      .account-editor-actions
        button#stationEditorSaveBtn.primary-btn(type='submit') Thêm trạm
        button#stationEditorCancelBtn.outline-btn(type='button') Hủy bỏ
